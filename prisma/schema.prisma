generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ChatSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum ChatFeedbackReason {
  IRRELEVANT
  UNCLEAR
  TOO_LONG
  INCORRECT
  OTHER
}

enum LeadQualificationStatus {
  ELIGIBLE
  NEEDS_REVIEW
  NOT_ELIGIBLE
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash")
  name         String        @db.VarChar(120)
  role         UserRole      @default(ADMIN)
  isActive     Boolean       @default(true) @map("is_active")
  sessions     UserSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(160)
  name        String   @db.VarChar(160)
  category    String   @db.VarChar(120)
  price       Int
  image       String?  @db.VarChar(500)
  specs       String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([category])
  @@map("products")
}

model Doctor {
  id                 String                     @id @default(uuid()) @db.Uuid
  slug               String                     @unique @db.VarChar(160)
  name               String                     @db.VarChar(160)
  specialty          String                     @db.VarChar(180)
  experience         String                     @db.VarChar(100)
  registrationNumber String?                    @map("registration_number") @db.VarChar(120)
  image              String?                    @db.VarChar(500)
  isActive           Boolean                    @default(true) @map("is_active")
  categories         DoctorCategoryAssignment[]
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("doctors")
}

model DoctorCategory {
  id          String                     @id @db.VarChar(50)
  name        String                     @unique @db.VarChar(120)
  description String?
  doctors     DoctorCategoryAssignment[]
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@map("doctor_categories")
}

model DoctorCategoryAssignment {
  doctorId   String         @map("doctor_id") @db.Uuid
  categoryId String         @map("category_id") @db.VarChar(50)
  doctor     Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  category   DoctorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([doctorId, categoryId])
  @@index([categoryId])
  @@map("doctor_category_assignments")
}

model ChatSession {
  id           String            @id @default(uuid()) @db.Uuid
  tokenHash    String            @unique @map("token_hash") @db.Char(64)
  status       ChatSessionStatus @default(ACTIVE)
  leadCaptured Boolean           @default(false) @map("lead_captured")
  isEmergency  Boolean           @default(false) @map("is_emergency")
  consentAt    DateTime?         @map("consent_at")
  consentVersion String?         @map("consent_version") @db.VarChar(40)
  expiresAt    DateTime          @map("expires_at")
  messages     ChatMessage[]
  lead         ChatLead?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([status])
  @@map("chat_sessions")
}

model ChatMessage {
  id                     String               @id @default(uuid()) @db.Uuid
  sessionId              String               @map("session_id") @db.Uuid
  role                   ChatMessageRole
  content                String
  sources                Json?                @db.JsonB
  relatedCare            Json?                @map("related_care") @db.JsonB
  modelUsed              String?              @map("model_used") @db.VarChar(160)
  intent                 String?              @db.VarChar(60)
  responseLatencyMs      Int?                 @map("response_latency_ms")
  gatewayLatencyMs       Int?                 @map("gateway_latency_ms")
  gatewayAttempts        Int?                 @map("gateway_attempts")
  fallbackUsed           Boolean?             @map("fallback_used")
  retrievalStatus        String?              @map("retrieval_status") @db.VarChar(40)
  retrievalLatencyMs     Int?                 @map("retrieval_latency_ms")
  retrievalMatchCount    Int?                 @map("retrieval_match_count")
  retrievalTopSimilarity Float?               @map("retrieval_top_similarity")
  session                ChatSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback               ChatMessageFeedback?
  createdAt              DateTime             @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@index([intent])
  @@map("chat_messages")
}

model ChatMessageFeedback {
  id        String             @id @default(uuid()) @db.Uuid
  messageId String             @unique @map("message_id") @db.Uuid
  rating    ChatFeedbackRating
  reason    ChatFeedbackReason?
  comment   String?            @db.VarChar(500)
  message   ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([rating])
  @@index([reason])
  @@map("chat_message_feedback")
}

model ChatLead {
  id                  String                   @id @default(uuid()) @db.Uuid
  sessionId           String                   @unique @map("session_id") @db.Uuid
  name                String?                  @db.VarChar(160)
  whatsapp            String?                  @db.VarChar(40)
  diabetesType        String?                  @map("diabetes_type") @db.VarChar(80)
  currentMedication   String?                  @map("current_medication")
  primaryComplaint    String?                  @map("primary_complaint")
  qualificationStatus LeadQualificationStatus? @map("qualification_status")
  session             ChatSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@map("chat_leads")
}

model KnowledgeBase {
  id        String                @id @default(uuid()) @db.Uuid
  title     String                @db.VarChar(240)
  content   String
  embedding Unsupported("vector(3072)")
  source    String                @unique @db.VarChar(240)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@map("knowledge_base")
}
