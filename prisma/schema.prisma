generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum ChatSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum ChatFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum ChatFeedbackReason {
  IRRELEVANT
  UNCLEAR
  TOO_LONG
  INCORRECT
  OTHER
}

enum LeadQualificationStatus {
  ELIGIBLE
  NEEDS_REVIEW
  NOT_ELIGIBLE
}

enum ConsultationMode {
  ONLINE
  OFFLINE
}

enum ScheduleSlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingActorType {
  PATIENT
  ADMIN
  SYSTEM
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash")
  name         String        @db.VarChar(120)
  role         UserRole      @default(ADMIN)
  isActive     Boolean       @default(true) @map("is_active")
  sessions     UserSession[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(160)
  name        String   @db.VarChar(160)
  category    String   @db.VarChar(120)
  price       Int
  image       String?  @db.VarChar(500)
  specs       String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([category])
  @@map("products")
}

model Doctor {
  id                 String                     @id @default(uuid()) @db.Uuid
  slug               String                     @unique @db.VarChar(160)
  name               String                     @db.VarChar(160)
  specialty          String                     @db.VarChar(180)
  experience         String                     @db.VarChar(100)
  registrationNumber String?                    @map("registration_number") @db.VarChar(120)
  image              String?                    @db.VarChar(500)
  isActive           Boolean                    @default(true) @map("is_active")
  categories         DoctorCategoryAssignment[]
  scheduleSlots      DoctorScheduleSlot[]
  bookings           ConsultationBooking[]
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("doctors")
}

model DoctorCategory {
  id          String                     @id @db.VarChar(50)
  name        String                     @unique @db.VarChar(120)
  description String?
  doctors     DoctorCategoryAssignment[]
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  @@map("doctor_categories")
}

model DoctorCategoryAssignment {
  doctorId   String         @map("doctor_id") @db.Uuid
  categoryId String         @map("category_id") @db.VarChar(50)
  doctor     Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  category   DoctorCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([doctorId, categoryId])
  @@index([categoryId])
  @@map("doctor_category_assignments")
}

model Clinic {
  id        String               @id @default(uuid()) @db.Uuid
  slug      String               @unique @db.VarChar(160)
  name      String               @db.VarChar(180)
  city      String               @db.VarChar(120)
  address   String
  whatsapp  String?              @db.VarChar(40)
  isActive  Boolean              @default(true) @map("is_active")
  slots     DoctorScheduleSlot[]
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([city])
  @@index([isActive])
  @@map("clinics")
}

model DoctorScheduleSlot {
  id        String                @id @default(uuid()) @db.Uuid
  doctorId  String                @map("doctor_id") @db.Uuid
  clinicId  String?               @map("clinic_id") @db.Uuid
  mode      ConsultationMode
  startsAt  DateTime              @map("starts_at")
  endsAt    DateTime              @map("ends_at")
  price     Int
  status    ScheduleSlotStatus    @default(AVAILABLE)
  notes     String?               @db.VarChar(300)
  doctor    Doctor                @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic    Clinic?               @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  bookings  ConsultationBooking[]
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@unique([doctorId, startsAt])
  @@index([status, startsAt])
  @@index([clinicId])
  @@map("doctor_schedule_slots")
}

model ConsultationBooking {
  id                     String             @id @default(uuid()) @db.Uuid
  bookingCode            String             @unique @map("booking_code") @db.VarChar(32)
  sessionId              String?            @map("session_id") @db.Uuid
  doctorId               String             @map("doctor_id") @db.Uuid
  slotId                 String             @map("slot_id") @db.Uuid
  patientName            String             @map("patient_name") @db.VarChar(160)
  whatsapp               String             @db.VarChar(40)
  complaint              String?            @db.VarChar(1000)
  preConsultationSummary Json?              @map("pre_consultation_summary") @db.JsonB
  status                 BookingStatus      @default(PENDING)
  consentAt              DateTime           @map("consent_at")
  deletionRequestedAt    DateTime?          @map("deletion_requested_at")
  anonymizedAt           DateTime?          @map("anonymized_at")
  session                ChatSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  doctor                 Doctor             @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  slot                   DoctorScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  events                 BookingEvent[]
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([slotId, status])
  @@index([doctorId, createdAt])
  @@index([sessionId])
  @@index([status, createdAt])
  @@index([deletionRequestedAt])
  @@map("consultation_bookings")
}

model BookingEvent {
  id             String              @id @default(uuid()) @db.Uuid
  bookingId      String              @map("booking_id") @db.Uuid
  actorType      BookingActorType    @map("actor_type")
  actorLabel     String?             @map("actor_label") @db.VarChar(160)
  action         String              @db.VarChar(80)
  previousStatus BookingStatus?      @map("previous_status")
  newStatus      BookingStatus?      @map("new_status")
  details        Json?               @db.JsonB
  booking        ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model ChatSession {
  id             String                @id @default(uuid()) @db.Uuid
  tokenHash      String                @unique @map("token_hash") @db.Char(64)
  status         ChatSessionStatus     @default(ACTIVE)
  leadCaptured   Boolean               @default(false) @map("lead_captured")
  isEmergency    Boolean               @default(false) @map("is_emergency")
  sbarComplete   Boolean               @default(false) @map("sbar_complete")
  consentAt      DateTime?             @map("consent_at")
  consentVersion String?               @map("consent_version") @db.VarChar(40)
  expiresAt      DateTime              @map("expires_at")
  messages       ChatMessage[]
  lead           ChatLead?
  bookings       ConsultationBooking[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@index([status])
  @@map("chat_sessions")
}

model ChatMessage {
  id                     String               @id @default(uuid()) @db.Uuid
  sessionId              String               @map("session_id") @db.Uuid
  role                   ChatMessageRole
  content                String
  sources                Json?                @db.JsonB
  relatedCare            Json?                @map("related_care") @db.JsonB
  modelUsed              String?              @map("model_used") @db.VarChar(160)
  intent                 String?              @db.VarChar(60)
  responseLatencyMs      Int?                 @map("response_latency_ms")
  gatewayLatencyMs       Int?                 @map("gateway_latency_ms")
  gatewayAttempts        Int?                 @map("gateway_attempts")
  fallbackUsed           Boolean?             @map("fallback_used")
  retrievalStatus        String?              @map("retrieval_status") @db.VarChar(40)
  retrievalLatencyMs     Int?                 @map("retrieval_latency_ms")
  retrievalMatchCount    Int?                 @map("retrieval_match_count")
  retrievalTopSimilarity Float?               @map("retrieval_top_similarity")
  session                ChatSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedback               ChatMessageFeedback?
  createdAt              DateTime             @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@index([intent])
  @@map("chat_messages")
}

model ChatMessageFeedback {
  id        String              @id @default(uuid()) @db.Uuid
  messageId String              @unique @map("message_id") @db.Uuid
  rating    ChatFeedbackRating
  reason    ChatFeedbackReason?
  comment   String?             @db.VarChar(500)
  message   ChatMessage         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@index([rating])
  @@index([reason])
  @@map("chat_message_feedback")
}

model ChatLead {
  id                  String                   @id @default(uuid()) @db.Uuid
  sessionId           String                   @unique @map("session_id") @db.Uuid
  name                String?                  @db.VarChar(160)
  whatsapp            String?                  @db.VarChar(40)
  diabetesType        String?                  @map("diabetes_type") @db.VarChar(80)
  currentMedication   String?                  @map("current_medication")
  primaryComplaint    String?                  @map("primary_complaint")
  qualificationStatus LeadQualificationStatus? @map("qualification_status")
  session             ChatSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@map("chat_leads")
}

model KnowledgeBase {
  id         String                @id @default(uuid()) @db.Uuid
  title      String                @db.VarChar(240)
  content    String
  embedding  Unsupported("vector")
  source     String                @db.VarChar(240)
  chunkIndex Int                   @default(0) @map("chunk_index")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  @@unique([source, chunkIndex])
  @@map("knowledge_base")
}
