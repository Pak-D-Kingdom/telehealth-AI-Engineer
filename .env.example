PORT=8000
NODE_ENV=development
X_AI_API_KEY=telehealth_ai_secret_key_dev

# Groq AI Key
GROQ_API_KEY=your_groq_api_key_here

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local Lightweight pgvector Database Connection (Port 5435 - no conflict with backend port 5434)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5435/telehealth_db

# Local Supabase Credentials (optional if using Supabase CLI)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your_local_supabase_anon_key
