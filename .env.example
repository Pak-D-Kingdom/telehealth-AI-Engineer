NODE_ENV=development
PORT=5000

POSTGRES_DB=telehealth
POSTGRES_USER=telehealth
POSTGRES_PASSWORD=telehealth_dev_password
POSTGRES_PORT=5434
DATABASE_URL=postgresql://telehealth:telehealth_dev_password@localhost:5434/telehealth?schema=public

FRONTEND_URL=http://localhost:3000
SESSION_TTL_DAYS=7
CHAT_SESSION_TTL_DAYS=30
ADMIN_NAME=Telehealth Admin
ADMIN_EMAIL=admin@glucocare.id
ADMIN_PASSWORD=change-this-local-password

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_REQUEST_TIMEOUT_MS=30000

# Multi API Keys for Rotation & Fallback
chatbot1_API_KEY=
chatbot2_API_KEY=
chatbot3_API_KEY=
chatbot4_API_KEY=
chatbot5_API_KEY=
chatbot6_API_KEY=
